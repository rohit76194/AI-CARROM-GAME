<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Carrom AI — Player vs Computer (A* Strategy)</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: ui-sans-serif, system-ui, sans-serif;
    background: #1e1810;
    color: #f5e6cc;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 32px 16px;
  }
  header { text-align: center; margin-bottom: 24px; max-width: 700px; }
  .badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 4px 12px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.05);
    font-size: 10px; text-transform: uppercase; letter-spacing: 0.25em;
    color: #bfa882; margin-bottom: 12px;
  }
  .badge-dot { width: 6px; height: 6px; border-radius: 50%; background: #d4856a; }
  h1 { font-size: 2.5rem; font-weight: 700; letter-spacing: -0.02em; }
  h1 span { background: linear-gradient(90deg, #d4856a, #e8c07a); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .subtitle { color: #bfa882; font-size: 0.9rem; margin-top: 8px; }

  .game-wrap { width: 100%; max-width: 680px; display: flex; flex-direction: column; gap: 16px; }

  /* HUD */
  .hud { display: grid; grid-template-columns: 1fr auto 1fr; gap: 12px; }
  .score-card {
    border-radius: 12px; padding: 12px 16px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.04);
    transition: border-color 0.3s;
  }
  .score-card.active { border-color: rgba(232,192,122,0.4); background: rgba(232,192,122,0.06); }
  .score-header { display: flex; align-items: center; gap: 8px; font-size: 10px; text-transform: uppercase; letter-spacing: 0.18em; color: #bfa882; }
  .score-header.right { flex-direction: row-reverse; }
  .coin-swatch { width: 24px; height: 24px; border-radius: 50%; border: 1px solid rgba(0,0,0,0.4); box-shadow: inset 0 1px 3px rgba(0,0,0,0.3); flex-shrink: 0; }
  .score-main { display: flex; align-items: baseline; gap: 6px; margin-top: 8px; }
  .score-main.right { justify-content: flex-end; }
  .score-val { font-size: 1.8rem; font-weight: 700; }
  .score-pts { font-size: 0.75rem; color: #bfa882; }
  .score-pocketed { font-size: 10px; color: #bfa882; margin-top: 4px; }
  .score-pocketed.right { text-align: right; }

  .queen-card {
    border-radius: 12px; padding: 12px 16px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.04);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-width: 100px;
  }
  .queen-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.18em; color: #bfa882; }
  .queen-coin { width: 28px; height: 28px; border-radius: 50%; margin-top: 6px; border: 1px solid rgba(80,15,10,0.6); }
  .queen-coin.pocketed { opacity: 0.3; }
  .queen-status { font-size: 10px; color: #bfa882; margin-top: 4px; }

  /* Status */
  .status-wrap { display: flex; justify-content: center; }
  .status-pill {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 16px; border-radius: 999px; font-size: 0.9rem;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .status-pill.human { border-color: rgba(232,192,122,0.35); background: rgba(232,192,122,0.08); }
  .status-pill.ai { border-color: rgba(212,133,106,0.35); background: rgba(212,133,106,0.08); }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; }
  .status-dot.human { background: #e8c07a; }
  .status-dot.ai { background: #d4856a; }
  .status-dot.think { background: #d4856a; animation: pulse 1.2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

  /* Board */
  .board-wrap { position: relative; border-radius: 16px; overflow: hidden;
    box-shadow: 0 30px 60px -15px rgba(0,0,0,0.6);
    border: 1px solid rgba(0,0,0,0.4);
  }
  canvas { width: 100%; height: auto; display: block; touch-action: none; }

  /* Winner overlay */
  .overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.65); backdrop-filter: blur(4px);
    display: none; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
  }
  .overlay.show { display: flex; }
  .overlay-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.3em; color: #bfa882; }
  .overlay-title { font-size: 2.2rem; font-weight: 700; }
  .overlay-score { font-size: 0.85rem; color: #bfa882; }
  .btn {
    padding: 10px 24px; border-radius: 999px; border: none; font-weight: 600; cursor: pointer; transition: opacity 0.2s;
    background: linear-gradient(90deg, #e8c07a, #d4a85c); color: #1e1810;
  }
  .btn:hover { opacity: 0.9; }

  /* Footer */
  .footer {
    display: flex; gap: 12px; justify-content: space-between; align-items: center;
    font-size: 12px; color: #bfa882;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px; padding: 12px 16px;
  }
  .footer button {
    padding: 8px 16px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.06); color: #f5e6cc; cursor: pointer; transition: background 0.2s;
    white-space: nowrap;
  }
  .footer button:hover { background: rgba(255,255,255,0.12); }
  .developer-credit {
    font-size: 12px; color: #bfa882; white-space: nowrap;
  }
</style>
</head>
<body>

<header>
  <div class="badge"><span class="badge-dot"></span> A* Search &middot; Player vs Computer</div>
  <h1>Carrom <span>AI</span></h1>
  <p class="subtitle">A classic carrom board powered by an A*-based shot planner. The AI evaluates striker positions, angles, and power to choose its best move.</p>
</header>

<div class="game-wrap">
  <div class="hud">
    <div class="score-card" id="card-human">
      <div class="score-header"><div class="coin-swatch" style="background:radial-gradient(circle at 30% 30%,#fff,#c9b48a)"></div><div>You<br><span style="opacity:0.7">White coins</span></div></div>
      <div class="score-main"><span class="score-val" id="score-human">0</span><span class="score-pts">pts</span></div>
      <div class="score-pocketed"><span id="pkt-human">0</span>/9 pocketed</div>
    </div>
    <div class="queen-card">
      <div class="queen-label">Queen</div>
      <div class="queen-coin" id="queen-coin" style="background:radial-gradient(circle at 30% 30%,#f08070,#6a1a14)"></div>
      <div class="queen-status" id="queen-status">On board</div>
    </div>
    <div class="score-card" id="card-ai">
      <div class="score-header right"><div class="coin-swatch" style="background:radial-gradient(circle at 30% 30%,#4a4a4a,#0a0a0a)"></div><div style="text-align:right">AI<br><span style="opacity:0.7">Black coins</span></div></div>
      <div class="score-main right"><span class="score-val" id="score-ai">0</span><span class="score-pts">pts</span></div>
      <div class="score-pocketed right"><span id="pkt-ai">0</span>/9 pocketed</div>
    </div>
  </div>

  <div class="status-wrap">
    <div class="status-pill human" id="status-pill">
      <span class="status-dot human" id="status-dot"></span>
      <span id="status-text">Your turn — drag from the striker to aim & shoot</span>
    </div>
  </div>

  <div class="board-wrap">
    <canvas id="board" width="640" height="640"></canvas>
    <div class="overlay" id="overlay">
      <div class="overlay-label">Match Over</div>
      <div class="overlay-title" id="winner-title">Victory</div>
      <div class="overlay-score" id="winner-score">Final · You 0 — 0 AI</div>
      <button class="btn" id="btn-overlay">Play again</button>
    </div>
  </div>

  <div class="footer">
    <p><strong style="color:#f5e6cc">How to play:</strong> click near the striker to slide it along the baseline, then drag <strong style="color:#f5e6cc">away</strong> to set angle &amp; power and release.</p>
    <div style="display: flex; gap: 12px; align-items: center;">
      <span class="developer-credit">Developer: Rohit S</span>
      <button id="btn-reset">New Game</button>
    </div>
  </div>
</div>

<script>
/* ========== CONFIG ========== */
const BOARD = 560;
const FRAME = 40;
const SIZE = BOARD + FRAME * 2;
const CX = SIZE / 2;
const CY = SIZE / 2;
const POCKET_R = 30;
const COIN_R = 14;
const STRIKER_R = 20;
const FRICTION = 0.99;
const MIN_SPEED = 0.05;
const CENTER_R = 70;
const POWER_MAX = 28;
const BASELINE_INSET = FRAME + 60;
const PLAYER_BASELINE_Y = SIZE - FRAME - 50;
const AI_BASELINE_Y = FRAME + 50;

const POCKETS = [
  { x: FRAME + 28, y: FRAME + 28 },
  { x: SIZE - FRAME - 28, y: FRAME + 28 },
  { x: FRAME + 28, y: SIZE - FRAME - 28 },
  { x: SIZE - FRAME - 28, y: SIZE - FRAME - 28 },
];

/* ========== STATE ========== */
let disks = initialCoins();
let striker = { id: 0, x: CX, y: PLAYER_BASELINE_Y, vx: 0, vy: 0, r: STRIKER_R, type: "striker", pocketed: false };
let turn = "human";
let animating = false;
let thinking = false;
let aim = null; // {angle, power}
let drag = null;  // {startX, startY}
let scores = { human: 0, ai: 0 };
let winner = null;
let message = "Your turn — drag from the striker to aim & shoot";

const canvas = document.getElementById("board");
const ctx = canvas.getContext("2d");

/* ========== INIT ========== */
function initialCoins() {
  const coins = [];
  let id = 1;
  coins.push({ id: id++, x: CX, y: CY, vx: 0, vy: 0, r: COIN_R, type: "red", pocketed: false });
  const ringR = COIN_R * 2 + 2;
  for (let i = 0; i < 6; i++) {
    const a = (i / 6) * Math.PI * 2 - Math.PI / 2;
    coins.push({ id: id++, x: CX + Math.cos(a) * ringR, y: CY + Math.sin(a) * ringR, vx: 0, vy: 0, r: COIN_R, type: i % 2 === 0 ? "white" : "black", pocketed: false });
  }
  const ring2 = ringR + COIN_R * 2 + 2;
  for (let i = 0; i < 12; i++) {
    const a = (i / 12) * Math.PI * 2;
    coins.push({ id: id++, x: CX + Math.cos(a) * ring2, y: CY + Math.sin(a) * ring2, vx: 0, vy: 0, r: COIN_R, type: i % 2 === 0 ? "white" : "black", pocketed: false });
  }
  return coins;
}

function resetGame() {
  disks = initialCoins();
  striker = { id: 0, x: CX, y: PLAYER_BASELINE_Y, vx: 0, vy: 0, r: STRIKER_R, type: "striker", pocketed: false };
  turn = "human";
  animating = false;
  thinking = false;
  aim = null;
  drag = null;
  scores = { human: 0, ai: 0 };
  winner = null;
  message = "Your turn — drag from the striker to aim & shoot";
  updateUI();
}

/* ========== PHYSICS ========== */
function stepPhysics(all) {
  for (const d of all) {
    if (d.pocketed) continue;
    d.x += d.vx; d.y += d.vy;
    d.vx *= FRICTION; d.vy *= FRICTION;
    if (Math.hypot(d.vx, d.vy) < MIN_SPEED) { d.vx = 0; d.vy = 0; }
  }
  const minX = FRAME + 8, maxX = SIZE - FRAME - 8;
  const minY = FRAME + 8, maxY = SIZE - FRAME - 8;
  for (const d of all) {
    if (d.pocketed) continue;
    if (d.x - d.r < minX) { d.x = minX + d.r; d.vx = -d.vx * 0.7; }
    if (d.x + d.r > maxX) { d.x = maxX - d.r; d.vx = -d.vx * 0.7; }
    if (d.y - d.r < minY) { d.y = minY + d.r; d.vy = -d.vy * 0.7; }
    if (d.y + d.r > maxY) { d.y = maxY - d.r; d.vy = -d.vy * 0.7; }
  }
  for (let i = 0; i < all.length; i++) {
    const a = all[i]; if (a.pocketed) continue;
    for (let j = i + 1; j < all.length; j++) {
      const b = all[j]; if (b.pocketed) continue;
      const dx = b.x - a.x, dy = b.y - a.y;
      const dist = Math.hypot(dx, dy);
      const minDist = a.r + b.r;
      if (dist > 0 && dist < minDist) {
        const nx = dx / dist, ny = dy / dist;
        const overlap = (minDist - dist) / 2;
        a.x -= nx * overlap; a.y -= ny * overlap;
        b.x += nx * overlap; b.y += ny * overlap;
        const av = a.vx * nx + a.vy * ny;
        const bv = b.vx * nx + b.vy * ny;
        const diff = bv - av;
        a.vx += diff * nx; a.vy += diff * ny;
        b.vx -= diff * nx; b.vy -= diff * ny;
      }
    }
  }
  for (const d of all) {
    if (d.pocketed) continue;
    for (const p of POCKETS) {
      if (Math.hypot(d.x - p.x, d.y - p.y) < POCKET_R - 2) {
        d.pocketed = true; d.vx = 0; d.vy = 0; break;
      }
    }
  }
}

function allStopped(all) {
  return all.every(d => d.pocketed || (d.vx === 0 && d.vy === 0));
}

function simulate(all, maxSteps = 1200) {
  const init = new Set(all.filter(d => d.pocketed).map(d => d.id));
  let steps = 0;
  while (!allStopped(all) && steps < maxSteps) { stepPhysics(all); steps++; }
  const pocketed = all.filter(d => d.pocketed && !init.has(d.id));
  return { pocketed, steps };
}

function cloneDisks(arr) { return arr.map(d => ({...d})); }

/* ========== AI (A*) ========== */
function evaluateShotForAI(shot) {
  const simDisks = cloneDisks(disks);
  simDisks.push({ id: 9999, x: shot.strikerX, y: AI_BASELINE_Y,
    vx: Math.cos(shot.angle) * shot.power,
    vy: Math.sin(shot.angle) * shot.power,
    r: STRIKER_R, type: "striker", pocketed: false });
  const { pocketed } = simulate(simDisks);
  let h = 0, strikerPocketed = false;
  for (const p of pocketed) {
    if (p.type === "striker") { strikerPocketed = true; h += 80; }
    else if (p.type === "black") h -= 80;
    else if (p.type === "white") h += 30;
    else if (p.type === "red") h -= 140;
  }
  const remainingBlacks = simDisks.filter(d => d.type === "black" && !d.pocketed);
  let distSum = 0;
  for (const c of remainingBlacks) {
    let best = Infinity;
    for (const p of POCKETS) best = Math.min(best, Math.hypot(c.x - p.x, c.y - p.y));
    distSum += best;
  }
  h += distSum * 0.02;
  const g = shot.power * 0.5 + (strikerPocketed ? 60 : 0);
  return g + h;
}

function planAIMove() {
  const candidates = [];
  const xPositions = [];
  for (let i = 0; i < 7; i++) xPositions.push(BASELINE_INSET + ((SIZE - 2 * BASELINE_INSET) * i) / 6);
  const targets = disks.filter(d => !d.pocketed && (d.type === "black" || d.type === "red"));
  const powers = [14, 20, 26];
  for (const sx of xPositions) {
    for (const t of targets) {
      for (const p of POCKETS) {
        const tpx = t.x - p.x, tpy = t.y - p.y;
        const tpLen = Math.hypot(tpx, tpy) || 1;
        const contactX = t.x + (tpx / tpLen) * (COIN_R + STRIKER_R);
        const contactY = t.y + (tpy / tpLen) * (COIN_R + STRIKER_R);
        const ang = Math.atan2(contactY - AI_BASELINE_Y, contactX - sx);
        if (ang <= 0.1 || ang >= Math.PI - 0.1) continue;
        for (const pw of powers) candidates.push({ strikerX: sx, angle: ang, power: pw });
      }
    }
  }
  let best = null, bestScore = Infinity;
  for (const c of candidates) {
    const s = evaluateShotForAI(c);
    if (s < bestScore) { bestScore = s; best = c; }
  }
  if (!best) best = { strikerX: CX, angle: Math.PI / 2 + (Math.random() - 0.5) * 0.4, power: 18 };
  return best;
}

function runAITurn() {
  thinking = true; updateUI();
  setTimeout(() => {
    const shot = planAIMove();
    const errAngle = (Math.random() - 0.5) * 0.12;
    const errPower = 1 + (Math.random() - 0.5) * 0.15;
    striker.x = shot.strikerX;
    striker.y = AI_BASELINE_Y;
    striker.vx = Math.cos(shot.angle + errAngle) * shot.power * errPower;
    striker.vy = Math.sin(shot.angle + errAngle) * shot.power * errPower;
    striker.pocketed = false;
    animating = true;
    thinking = false;
    updateUI();
  }, 600);
}

/* ========== TURN / SCORING ========== */
function endOfShot() {
  let humanPocketed = 0, aiPocketed = 0, queenPocketed = false, strikerPocketed = striker.pocketed;
  for (const d of disks) {
    if (!d.pocketed) continue;
    if (d._counted) continue;
    d._counted = true;
    if (d.type === "white") { scores.human += 1; humanPocketed++; }
    else if (d.type === "black") { scores.ai += 1; aiPocketed++; }
    else if (d.type === "red") { queenPocketed = true; if (turn === "human") scores.human += 3; else scores.ai += 3; }
  }

  const whiteLeft = disks.filter(d => d.type === "white" && !d.pocketed).length;
  const blackLeft = disks.filter(d => d.type === "black" && !d.pocketed).length;
  if (whiteLeft === 0 || blackLeft === 0) {
    winner = scores.human > scores.ai ? "human" : "ai";
    message = winner === "human" ? "You win!" : "AI wins this round.";
    updateUI();
    return;
  }

  const myPocketed = turn === "human" ? humanPocketed : aiPocketed;
  const foul = strikerPocketed && myPocketed === 0;
  const continueTurn = myPocketed > 0 && !foul;
  const next = continueTurn ? turn : (turn === "human" ? "ai" : "human");
  turn = next;

  striker = { id: 0, x: CX, y: next === "human" ? PLAYER_BASELINE_Y : AI_BASELINE_Y, vx: 0, vy: 0, r: STRIKER_R, type: "striker", pocketed: false };

  if (next === "ai") {
    message = foul ? "Foul! AI's turn." : "AI's turn…";
    runAITurn();
  } else {
    message = continueTurn ? "Nice pocket! Shoot again." : foul ? "Foul. Your turn again — careful!" : "Your turn — aim & shoot";
  }
  updateUI();
}

/* ========== UI UPDATE ========== */
function updateUI() {
  document.getElementById("score-human").textContent = scores.human;
  document.getElementById("score-ai").textContent = scores.ai;
  document.getElementById("pkt-human").textContent = disks.filter(d => d.type === "white" && d.pocketed).length;
  document.getElementById("pkt-ai").textContent = disks.filter(d => d.type === "black" && d.pocketed).length;

  const queenOnBoard = !disks.some(d => d.type === "red" && d.pocketed);
  document.getElementById("queen-coin").classList.toggle("pocketed", !queenOnBoard);
  document.getElementById("queen-status").textContent = queenOnBoard ? "On board" : "Pocketed";

  const pill = document.getElementById("status-pill");
  const dot = document.getElementById("status-dot");
  pill.className = "status-pill " + (thinking ? "ai" : turn);
  dot.className = "status-dot " + (thinking ? "think" : turn);
  document.getElementById("status-text").textContent = thinking ? "AI is analyzing the board (A* search)…" : message;

  document.getElementById("card-human").classList.toggle("active", turn === "human" && !thinking);
  document.getElementById("card-ai").classList.toggle("active", turn === "ai" || thinking);

  const overlay = document.getElementById("overlay");
  if (winner) {
    overlay.classList.add("show");
    document.getElementById("winner-title").textContent = winner === "human" ? "Victory" : "AI Wins";
    document.getElementById("winner-score").textContent = `Final · You ${scores.human} — ${scores.ai} AI`;
  } else {
    overlay.classList.remove("show");
  }
}

/* ========== INPUT ========== */
function getPos(e) {
  const rect = canvas.getBoundingClientRect();
  return {
    x: ((e.clientX - rect.left) / rect.width) * SIZE,
    y: ((e.clientY - rect.top) / rect.height) * SIZE,
  };
}

canvas.addEventListener("pointerdown", e => {
  if (turn !== "human" || animating || winner) return;
  const pos = getPos(e);
  if (Math.abs(pos.y - PLAYER_BASELINE_Y) < 40 && Math.hypot(pos.x - striker.x, pos.y - striker.y) < 60) {
    striker.x = Math.max(BASELINE_INSET, Math.min(SIZE - BASELINE_INSET, pos.x));
  }
  drag = { startX: striker.x, startY: striker.y };
});

canvas.addEventListener("pointermove", e => {
  if (!drag || turn !== "human" || animating) return;
  const pos = getPos(e);
  const dx = striker.x - pos.x;
  const dy = striker.y - pos.y;
  const power = Math.min(POWER_MAX, Math.hypot(dx, dy) / 8);
  const angle = Math.atan2(dy, dx);
  aim = { angle, power };
});

function release() {
  if (!drag || turn !== "human" || animating) { drag = null; aim = null; return; }
  if (aim && aim.power > 2) {
    striker.vx = Math.cos(aim.angle) * aim.power;
    striker.vy = Math.sin(aim.angle) * aim.power;
    animating = true;
  }
  drag = null; aim = null;
}

canvas.addEventListener("pointerup", release);
canvas.addEventListener("pointerleave", release);

document.getElementById("btn-reset").addEventListener("click", resetGame);
document.getElementById("btn-overlay").addEventListener("click", resetGame);

/* ========== RENDERING ========== */
function drawBoard() {
  // Frame
  ctx.fillStyle = "#6b4e32";
  ctx.fillRect(0, 0, SIZE, SIZE);
  const bevel = ctx.createLinearGradient(0, 0, 0, SIZE);
  bevel.addColorStop(0, "rgba(255,220,170,0.35)");
  bevel.addColorStop(0.5, "rgba(0,0,0,0)");
  bevel.addColorStop(1, "rgba(0,0,0,0.45)");
  ctx.fillStyle = bevel; ctx.fillRect(0, 0, SIZE, SIZE);
  ctx.save(); ctx.globalAlpha = 0.12;
  for (let i = 0; i < 60; i++) {
    ctx.strokeStyle = i % 2 ? "rgba(60,30,10,0.6)" : "rgba(255,210,160,0.4)";
    ctx.lineWidth = 0.8;
    ctx.beginPath();
    const y = (i / 60) * SIZE + Math.sin(i) * 2;
    ctx.moveTo(0, y);
    ctx.bezierCurveTo(SIZE * 0.3, y + Math.sin(i * 1.7) * 6, SIZE * 0.7, y + Math.cos(i * 1.3) * 6, SIZE, y);
    ctx.stroke();
  }
  ctx.restore();

  // Playing surface
  const boardGrad = ctx.createRadialGradient(CX, CY, BOARD * 0.1, CX, CY, BOARD * 0.75);
  boardGrad.addColorStop(0, "#dcb896");
  boardGrad.addColorStop(1, "#c4a076");
  ctx.fillStyle = boardGrad;
  ctx.fillRect(FRAME, FRAME, BOARD, BOARD);

  ctx.save(); ctx.globalAlpha = 0.08;
  ctx.strokeStyle = "rgba(90,50,20,0.6)"; ctx.lineWidth = 0.5;
  for (let i = 0; i < 80; i++) {
    ctx.beginPath();
    const y = FRAME + (i / 80) * BOARD;
    ctx.moveTo(FRAME, y + Math.sin(i * 0.9) * 1.2);
    ctx.bezierCurveTo(FRAME + BOARD * 0.4, y + Math.sin(i * 1.4) * 2, FRAME + BOARD * 0.6, y + Math.cos(i * 0.7) * 2, FRAME + BOARD, y);
    ctx.stroke();
  }
  ctx.restore();

  // Inner border
  ctx.strokeStyle = "rgba(60,30,10,0.6)"; ctx.lineWidth = 2;
  ctx.strokeRect(FRAME + 4, FRAME + 4, BOARD - 8, BOARD - 8);

  const lineColor = "rgba(80,40,15,0.75)";
  ctx.strokeStyle = lineColor; ctx.lineWidth = 1.5;

  // Baselines
  const baseEndR = 9;
  for (const by of [PLAYER_BASELINE_Y, AI_BASELINE_Y]) {
    ctx.beginPath();
    ctx.moveTo(BASELINE_INSET, by - 6); ctx.lineTo(SIZE - BASELINE_INSET, by - 6);
    ctx.moveTo(BASELINE_INSET, by + 6); ctx.lineTo(SIZE - BASELINE_INSET, by + 6);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(BASELINE_INSET, by, baseEndR, 0, Math.PI * 2);
    ctx.arc(SIZE - BASELINE_INSET, by, baseEndR, 0, Math.PI * 2);
    ctx.stroke();
  }
  for (const bx of [FRAME + 50, SIZE - FRAME - 50]) {
    ctx.beginPath();
    ctx.moveTo(bx - 6, BASELINE_INSET); ctx.lineTo(bx - 6, SIZE - BASELINE_INSET);
    ctx.moveTo(bx + 6, BASELINE_INSET); ctx.lineTo(bx + 6, SIZE - BASELINE_INSET);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(bx, BASELINE_INSET, baseEndR, 0, Math.PI * 2);
    ctx.arc(bx, SIZE - BASELINE_INSET, baseEndR, 0, Math.PI * 2);
    ctx.stroke();
  }

  // Diagonal arrows
  ctx.strokeStyle = "rgba(80,40,15,0.55)"; ctx.lineWidth = 1;
  for (const p of POCKETS) {
    const dx = CX - p.x, dy = CY - p.y;
    const len = Math.hypot(dx, dy);
    const ux = dx / len, uy = dy / len;
    ctx.beginPath();
    ctx.moveTo(p.x + ux * (POCKET_R + 6), p.y + uy * (POCKET_R + 6));
    ctx.lineTo(p.x + ux * (len - CENTER_R - 6), p.y + uy * (len - CENTER_R - 6));
    ctx.stroke();
  }

  // Center circle
  ctx.beginPath(); ctx.arc(CX, CY, CENTER_R, 0, Math.PI * 2);
  ctx.fillStyle = "rgba(220,60,40,0.12)"; ctx.fill();
  ctx.strokeStyle = "rgba(180,40,30,0.85)"; ctx.lineWidth = 2; ctx.stroke();
  ctx.beginPath(); ctx.arc(CX, CY, CENTER_R - 8, 0, Math.PI * 2);
  ctx.strokeStyle = "rgba(180,40,30,0.45)"; ctx.lineWidth = 1; ctx.stroke();
  ctx.save(); ctx.translate(CX, CY); ctx.strokeStyle = "rgba(180,40,30,0.5)";
  for (let i = 0; i < 6; i++) {
    ctx.rotate(Math.PI / 3);
    ctx.beginPath(); ctx.arc(0, -CENTER_R / 2, CENTER_R / 2, 0, Math.PI * 2); ctx.stroke();
  }
  ctx.restore();
  ctx.beginPath(); ctx.arc(CX, CY, 4, 0, Math.PI * 2);
  ctx.fillStyle = "rgba(180,40,30,0.95)"; ctx.fill();

  // Pockets
  for (const p of POCKETS) {
    const rim = ctx.createRadialGradient(p.x, p.y, POCKET_R - 4, p.x, p.y, POCKET_R + 10);
    rim.addColorStop(0, "rgba(0,0,0,0.55)"); rim.addColorStop(1, "rgba(0,0,0,0)");
    ctx.fillStyle = rim; ctx.beginPath(); ctx.arc(p.x, p.y, POCKET_R + 10, 0, Math.PI * 2); ctx.fill();
    const hole = ctx.createRadialGradient(p.x - 4, p.y - 4, 2, p.x, p.y, POCKET_R);
    hole.addColorStop(0, "#1a1a1a"); hole.addColorStop(1, "#000");
    ctx.fillStyle = hole; ctx.beginPath(); ctx.arc(p.x, p.y, POCKET_R, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = "rgba(255,255,255,0.08)"; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(p.x, p.y, POCKET_R - 3, 0, Math.PI * 2); ctx.stroke();
  }
}

function lighten(color, amount) {
  const m = color.match(/oklch\(\s*([\d.]+)\s+([\d.]+)\s+([\d.]+)\s*\)/);
  if (m) { const l = Math.min(1, parseFloat(m[1]) + amount); return `oklch(${l} ${m[2]} ${m[3]})`; }
  return color;
}

const PALETTE = {
  white: "oklch(0.95 0.03 85)",
  black: "oklch(0.18 0.015 40)",
  red: "oklch(0.58 0.22 25)",
  striker: "oklch(0.55 0.18 250)",
};

function drawDisk(d) {
  let base = "#fff", rim = "rgba(0,0,0,0.4)", dark = "rgba(0,0,0,0.35)";
  if (d.type === "white") { base = PALETTE.white; rim = "rgba(120,80,30,0.5)"; dark = "rgba(140,90,40,0.4)"; }
  else if (d.type === "black") { base = PALETTE.black; rim = "rgba(255,255,255,0.18)"; dark = "rgba(0,0,0,0.7)"; }
  else if (d.type === "red") { base = PALETTE.red; rim = "rgba(80,15,10,0.7)"; dark = "rgba(80,15,10,0.5)"; }
  else if (d.type === "striker") { base = PALETTE.striker; rim = "rgba(20,30,80,0.7)"; dark = "rgba(20,30,80,0.5)"; }

  ctx.beginPath(); ctx.arc(d.x + 3, d.y + 4, d.r, 0, Math.PI * 2);
  ctx.fillStyle = "rgba(0,0,0,0.35)"; ctx.fill();

  const grad = ctx.createRadialGradient(d.x - d.r * 0.4, d.y - d.r * 0.4, d.r * 0.1, d.x, d.y, d.r);
  grad.addColorStop(0, lighten(base, 0.25));
  grad.addColorStop(0.6, base);
  grad.addColorStop(1, dark);
  ctx.beginPath(); ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
  ctx.fillStyle = grad; ctx.fill();

  ctx.lineWidth = 1.5; ctx.strokeStyle = rim; ctx.stroke();

  ctx.beginPath(); ctx.arc(d.x, d.y, d.r * 0.78, 0, Math.PI * 2);
  ctx.strokeStyle = d.type === "black" ? "rgba(255,255,255,0.12)" : "rgba(0,0,0,0.18)";
  ctx.lineWidth = 1; ctx.stroke();

  const spec = ctx.createRadialGradient(d.x - d.r * 0.45, d.y - d.r * 0.5, 0, d.x - d.r * 0.45, d.y - d.r * 0.5, d.r * 0.7);
  spec.addColorStop(0, "rgba(255,255,255,0.55)"); spec.addColorStop(1, "rgba(255,255,255,0)");
  ctx.beginPath(); ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
  ctx.fillStyle = spec; ctx.fill();

  if (d.type === "striker") {
    ctx.strokeStyle = "rgba(255,255,255,0.7)"; ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(d.x - d.r * 0.35, d.y); ctx.lineTo(d.x + d.r * 0.35, d.y);
    ctx.moveTo(d.x, d.y - d.r * 0.35); ctx.lineTo(d.x, d.y + d.r * 0.35);
    ctx.stroke();
  }
}

/* ========== MAIN LOOP ========== */
function loop() {
  ctx.clearRect(0, 0, SIZE, SIZE);
  drawBoard();
  for (const d of disks) { if (!d.pocketed) drawDisk(d); }
  if (!striker.pocketed) drawDisk(striker);

  if (turn === "human" && !animating && aim) {
    const { angle, power } = aim;
    const len = power * 6;
    const grad = ctx.createLinearGradient(striker.x, striker.y, striker.x + Math.cos(angle) * len, striker.y + Math.sin(angle) * len);
    grad.addColorStop(0, "rgba(255,255,255,0.95)");
    grad.addColorStop(1, "rgba(255,180,80,0.1)");
    ctx.strokeStyle = grad; ctx.lineWidth = 3; ctx.setLineDash([8, 6]);
    ctx.beginPath();
    ctx.moveTo(striker.x, striker.y);
    ctx.lineTo(striker.x + Math.cos(angle) * len, striker.y + Math.sin(angle) * len);
    ctx.stroke(); ctx.setLineDash([]);

    const tipX = striker.x + Math.cos(angle) * len;
    const tipY = striker.y + Math.sin(angle) * len;
    ctx.fillStyle = "rgba(255,200,120,0.9)";
    ctx.beginPath();
    ctx.moveTo(tipX, tipY);
    ctx.lineTo(tipX - Math.cos(angle - 0.4) * 12, tipY - Math.sin(angle - 0.4) * 12);
    ctx.lineTo(tipX - Math.cos(angle + 0.4) * 12, tipY - Math.sin(angle + 0.4) * 12);
    ctx.closePath(); ctx.fill();

    const barW = BOARD - 40, barX = FRAME + 20, barY = SIZE - FRAME - 18;
    ctx.fillStyle = "rgba(0,0,0,0.35)"; ctx.fillRect(barX, barY, barW, 8);
    const pg = ctx.createLinearGradient(barX, 0, barX + barW, 0);
    pg.addColorStop(0, "#4ade80"); pg.addColorStop(0.5, "#facc15"); pg.addColorStop(1, "#ef4444");
    ctx.fillStyle = pg; ctx.fillRect(barX, barY, barW * (power / POWER_MAX), 8);
  }

  if (animating) {
    const all = [...disks, striker];
    stepPhysics(all);
    if (allStopped(all)) {
      animating = false;
      endOfShot();
    }
  }

  requestAnimationFrame(loop);
}

/* ========== START ========== */
updateUI();
loop();
</script>
